# Docker build ignore file for Dockerfile.local multi-stage build
# We need most source files for the build, so this is minimal

# Explicitly include critical Bazel workspace files (must be first)
!.bazelrc
!.bazelversion
!MODULE.bazel
!MODULE.bazel.lock
!WORKSPACE
!WORKSPACE.bzlmod

# Bazel cache (will be rebuilt in container)
bazel-bin/
bazel-out/
bazel-testlogs/
bazel-envoy/

# Build outputs from host
/tmp/

# Git metadata (large and not needed for build)
.git/objects/
.git/logs/
.github/workflows/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Generated documentation
generated/

# Keep these critical files for Bazel build:
# .bazelrc, .bazelversion, MODULE.bazel, WORKSPACE, bazel/, source/, api/, etc.
